VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional. Defaults to ${VITE_SUPABASE_URL}/functions/v1/api
VITE_REACH_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
# Set true ONLY for an explicitly labelled local/demo build. Never enable in production.
VITE_REACH_DEMO_MODE=false
# Supabase Edge Function secrets (configure server-side, not in VITE_ variables)
REACH_ALLOWED_ORIGINS=https://your-platform.example,https://your-citizen.example
REACH_OPERATOR_PROVISION_KEY=generate-a-long-random-secret
# Optional server-side AI model adapter. Never expose this key to the browser.
# The system prompt is deliberately identity-neutral: a provider that does not recognise a
# claimed role can refuse it and answer in prose with HTTP 200, which fails silently. See
# docs/HELIX_API_TEST_NOTES.md before pointing this at a new provider.
# Launchverse/Helix: endpoint https://api.launchverse.app/api/v1/chat/completions,
# key prefix helix_. Use helix-advisor: the agentic models (helix-autopilot, helix/swe-v1,
# helix/devops-v1) append an agent work report after the JSON, which this adapter rejects,
# and helix-operator is scope-blocked. Free tier allows 20 queries/day (team-level).
REACH_AI_ENDPOINT=
REACH_AI_API_KEY=
REACH_AI_MODEL=
# Optional. Lower it (e.g. 3) to fail over to the deterministic engine sooner.
REACH_AI_BREAKER_THRESHOLD=

# BMONI Embedded server-side secrets. NEVER expose these as VITE_ variables.
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=
BMONI_WEBHOOK_SECRET=
# The destination wallet that receives institutional REACH subscription transfers.
REACH_BMONI_TREASURY_ADDRESS=
# Institutional subscription price, represented as a decimal CNGN amount.
REACH_INSTITUTION_SUBSCRIPTION_AMOUNT_CNGN=

# Security
# Never set REACH_ALLOW_STAR_CORS=true in production.
# REACH_OPERATOR_PROVISION_KEY is bootstrap-only (first super-admin). Day-to-day operators use invitations.
